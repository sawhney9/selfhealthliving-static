# Security headers for Cloudflare Pages.
# Signed-in pages keep the Supabase session in localStorage, so the CSP's job is
# to make sure only our own scripts (plus Cloudflare's analytics beacon) can run.
# Astro is set to emit scripts as files (astro.config.mjs), so our own pages
# need no inline JS. Inline styles stay allowed for style="" attributes.
# Pages already sends X-Content-Type-Options and Referrer-Policy.

# Public pages: Cloudflare injects an inline bot-detection snippet on the live
# domain, so inline scripts are allowed here; script hosts are still locked down.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://zjnxcjbuezltovvazohu.supabase.co https://cloudflareinsights.com; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Sign-in and health-data pages: no inline scripts at all.
/login*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://zjnxcjbuezltovvazohu.supabase.co https://cloudflareinsights.com; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  ! X-Frame-Options
  X-Frame-Options: DENY

/account*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://zjnxcjbuezltovvazohu.supabase.co https://cloudflareinsights.com; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  ! X-Frame-Options
  X-Frame-Options: DENY

# The app-story demo is a standalone page with its own inline scripts; it is
# only framed by our own article.
/embeds/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

---
import Layout from '../../layouts/Layout.astro';
import AccountPanel from '../../components/AccountPanel.astro';
import SaveReading from '../../components/SaveReading.astro';
import ImproveTips from '../../components/ImproveTips.astro';
---

<Layout
  title="Triglyceride/HDL Ratio Calculator | Self Health Living"
  description="Calculate your triglyceride-to-HDL ratio from a standard lipid panel and track it over time as a proxy for insulin resistance."
  currentPillar="tools"
>
  <div class="py-14 px-6 md:px-12 max-w-3xl mx-auto w-full relative">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-green-accent mb-4">
      <a href="/tools/" class="hover:underline">Tools</a>
      <span>&bull;</span>
      <span class="text-slate-400">calculator</span>
    </div>

    <h1 class="font-display font-black text-3xl sm:text-5xl text-slate-900 tracking-tight mb-4">
      Triglyceride/HDL Ratio Calculator
    </h1>
    <p class="text-slate-500 text-base leading-relaxed mb-10 max-w-2xl">
      Divide your triglycerides by your HDL and you get one of the better insulin-resistance proxies you can pull from a routine lipid panel — often more useful day-to-day than staring at LDL alone. It's also sensitive to diet and weight changes, so it's worth re-checking each time you get bloodwork done.
    </p>

    <AccountPanel />

    <div class="glass-card p-6 md:p-8 mb-8">
      <form id="calc-form" data-tool="triglyceride-hdl-ratio" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1.5">Triglycerides (mg/dL)</span>
          <input type="number" step="any" min="0" required id="tg" class="w-full rounded-lg border border-black/10 px-3 py-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-green-accent/40" />
        </label>
        <label class="block">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1.5">HDL Cholesterol (mg/dL)</span>
          <input type="number" step="any" min="0" required id="hdl" class="w-full rounded-lg border border-black/10 px-3 py-2.5 text-slate-900 focus:outline-none focus:ring-2 focus:ring-green-accent/40" />
        </label>
        <div class="sm:col-span-2 flex flex-wrap gap-3 mt-2">
          <button type="submit" class="px-6 py-2.5 rounded-full text-sm font-bold text-white bg-green-accent hover:bg-green-accent-hover transition-all duration-300 cursor-pointer">
            Calculate
          </button>
        </div>
      </form>

      <div id="result" class="hidden mt-6 pt-6 border-t border-black/6"></div>
      <SaveReading />
    </div>

    <div class="glass-card p-6 md:p-8 mb-8">
      <h2 class="font-display font-bold text-lg text-slate-900 mb-4">Your Trend</h2>
      <div id="history"></div>
    </div>

    <ImproveTips tool="triglyceride-hdl-ratio" />

    <p class="text-sm text-slate-500 mb-8">
      Want the full picture on what these numbers mean together? Read
      <a href="/train/decoding-blood-sugar/" class="text-green-accent font-semibold hover:underline">Decoding Your Blood Sugar</a>.
    </p>

    <p class="text-xs text-slate-400 leading-relaxed border-t border-black/6 pt-6">
      <strong class="text-slate-500">Not medical advice.</strong> This calculator is for informational purposes only and isn't a substitute for professional medical advice, diagnosis, or treatment. The ratio bands shown are general research-based heuristics, not diagnostic cutoffs. Always talk to your doctor about your lab results and personal risk factors.
    </p>
  </div>
</Layout>

<script>
  import { initTrend } from '../../lib/toolTrend.js';
  import { toolBySlug } from '../../lib/tools.js';

  function classify(ratio: number) {
    if (ratio < 2) {
      return { label: 'Optimal', color: 'text-green-accent', note: 'Associated with lower insulin resistance risk.' };
    }
    if (ratio <= 4) {
      return { label: 'Borderline', color: 'text-amber-accent', note: 'Worth watching alongside diet, activity, and weight changes.' };
    }
    return { label: 'High', color: 'text-red-500', note: 'Associated with higher insulin resistance risk — worth discussing with your doctor.' };
  }

  function init() {
    const form = document.getElementById('calc-form') as HTMLFormElement | null;
    if (form?.dataset.tool !== 'triglyceride-hdl-ratio') return;
    const resultEl = document.getElementById('result');
    if (!form || !resultEl) return;

    const trend = initTrend(toolBySlug('triglyceride-hdl-ratio'));

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const tg = parseFloat((document.getElementById('tg') as HTMLInputElement).value);
      const hdl = parseFloat((document.getElementById('hdl') as HTMLInputElement).value);
      if (!tg || !hdl) return;

      const ratio = tg / hdl;
      const { label, color, note } = classify(ratio);

      resultEl.classList.remove('hidden');
      resultEl.innerHTML = `
        <p class="text-sm text-slate-500 mb-1">Your Triglyceride/HDL Ratio</p>
        <p class="font-display font-black text-4xl text-slate-900 mb-2">${ratio.toFixed(2)} <span class="text-lg font-bold ${color}">${label}</span></p>
        <p class="text-sm text-slate-500">${note}</p>
      `;
      trend.ready(ratio, {
        inputs: { tg, hdl },
        labs: [
          { test_name: 'Triglycerides', value: tg, unit: 'mg/dL' },
          { test_name: 'HDL', value: hdl, unit: 'mg/dL' },
        ],
      });
    });
  }

  document.addEventListener('astro:page-load', init);
</script>

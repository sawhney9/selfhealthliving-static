---
import Layout from '../layouts/Layout.astro';

const signalsMap = import.meta.glob('../content/signals/*.md', { eager: true });
const allSignals = Object.values(signalsMap);
const bySlug = Object.fromEntries(allSignals.map((p) => [p.frontmatter.slug, p]));

const featuredSlugs = [
  'decoding-blood-sugar',
  'fish-oil-omega-3-dose-that-actually-works',
  'grip-strength-predicts-death-better-than-blood-pressure',
];
const featuredPosts = featuredSlugs.map((slug) => bySlug[slug]).filter(Boolean);
---

<Layout
  title="Self Health Living | Read Your Own Health Data"
  description="CGMs, wearables, lab panels, and AI — we translate your own health data into plain guidance, plus science-backed training and nutrition."
>
  <!-- ══════════════════════════════════════
       HERO — mission-led, with a live "signal" card
       ══════════════════════════════════════ -->
  <section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden aurora-hero bg-grid-pattern">
    <div class="max-w-6xl mx-auto px-6 relative z-10 grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-14 items-center">

      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-accent/10 border border-amber-accent/25 rounded-full text-xs font-semibold text-amber-accent mb-7 uppercase tracking-wider" data-reveal="fade">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-accent animate-pulse"></span>
          The health system is stretched thin
        </div>

        <h1 class="font-display font-extrabold text-4xl sm:text-6xl text-slate-900 tracking-tighter leading-[1.08] mb-6 max-w-xl" data-reveal="fade" data-reveal-delay="100">
          Your health is <span class="font-serif italic font-normal text-green-accent">your</span> priority. Know what's going on underneath.
        </h1>

        <p class="font-sans text-slate-500 text-base sm:text-lg leading-relaxed max-w-lg mb-10" data-reveal="fade" data-reveal-delay="200">
          We translate CGMs, blood panels, and wearable data into plain guidance you can actually use, so you walk into your next appointment already understanding what your body is telling you.
        </p>

        <div class="flex items-center gap-6 flex-wrap" data-reveal="fade" data-reveal-delay="300">
          <a href="/signals" class="inline-flex items-center gap-2 px-7 py-3.5 bg-green-accent hover:bg-green-accent-hover text-white text-sm font-bold rounded-full transition-all duration-300 shadow-sm hover:shadow-[0_8px_20px_rgba(0,163,108,0.35)] hover:-translate-y-0.5">
            Start with Signals →
          </a>
          <a href="/app" class="text-sm font-semibold text-slate-500 hover:text-slate-900 transition-colors">
            or see what the app automates ↓
          </a>
        </div>
      </div>

      <!-- Live signal card -->
      <div class="relative h-[360px] sm:h-[420px]" data-reveal="scale" data-reveal-delay="200">
        <div class="absolute w-[340px] h-[340px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-green-accent/12 rounded-full blur-[70px] pointer-events-none animate-pulse-glow"></div>

        <!-- Peek card: grip strength -->
        <div class="absolute w-[168px] right-2 sm:right-6 bottom-4 z-10 glass-card p-4 animate-float-slow">
          <div class="text-[10px] font-bold uppercase tracking-wider text-cyan-accent mb-1.5">Grip Strength</div>
          <div class="font-display font-extrabold text-xl text-slate-900">41.2<span class="text-xs text-slate-400 font-semibold ml-1">kg avg</span></div>
        </div>

        <!-- Main card: glucose signal -->
        <div class="absolute w-[290px] left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 glass-card p-6 animate-float">
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-green-accent">
              <span class="w-1.5 h-1.5 rounded-full bg-green-accent animate-pulse"></span>
              Live signal
            </span>
            <span class="text-[10px] text-slate-400 font-mono">2:14 PM</span>
          </div>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="font-display font-extrabold text-4xl text-slate-900 tracking-tight">94</span>
            <span class="text-xs text-slate-400 font-semibold">mg/dL</span>
          </div>
          <div class="text-xs text-slate-500 mb-4">Glucose · post-lunch</div>
          <div class="inline-flex items-center gap-1 text-[11px] font-bold text-green-accent bg-green-accent/10 px-2.5 py-1 rounded-full mb-4">
            Stable range
          </div>
          <div class="border-t border-black/6 pt-3">
            <svg viewBox="0 0 260 44" class="w-full h-9" preserveAspectRatio="none">
              <polyline points="0,30 20,26 42,32 64,17 86,23 108,12 130,19 152,8 174,15 196,10 218,17 240,13 260,19" fill="none" stroke="#00A36C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="260" cy="19" r="3.5" fill="#00A36C" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- ══════════════════════════════════════
       PILLARS — Signals, Train, Fuel
       ══════════════════════════════════════ -->
  <section class="py-20 md:py-28 bg-white relative">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <a href="/signals" class="glass-card p-7 flex flex-col gap-4 group" data-reveal="fade">
          <div class="flex items-center justify-between">
            <div class="w-11 h-11 rounded-xl bg-green-accent/10 text-green-accent flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2 15h4l2-7 4 12 3-9 2 4h5" />
              </svg>
            </div>
            <span class="text-[9px] font-extrabold uppercase tracking-wider bg-green-accent text-white px-2 py-0.5 rounded-full">New</span>
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-green-accent block mb-2">Signals</span>
            <h3 class="font-display font-bold text-xl text-slate-900 mb-2">Health tech &amp; biomarkers</h3>
            <p class="text-sm text-slate-500 leading-relaxed">CGMs, wearables, and lab panels — what the numbers actually mean and how to act on them.</p>
          </div>
          <span class="text-sm font-semibold text-green-accent flex items-center gap-1 mt-auto group-hover:gap-2 transition-all">Read Signals →</span>
        </a>

        <a href="/train" class="glass-card p-7 flex flex-col gap-4 group" data-reveal="fade" data-reveal-delay="100">
          <div class="w-11 h-11 rounded-xl bg-cyan-accent/10 text-cyan-accent flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V10M10 19V5M16 19v-7M20 19V8" />
            </svg>
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-cyan-accent block mb-2">Train</span>
            <h3 class="font-display font-bold text-xl text-slate-900 mb-2">Strength &amp; longevity</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Resistance training, VO2 max, recovery — the protocols that compound over decades, not weeks.</p>
          </div>
          <span class="text-sm font-semibold text-cyan-accent flex items-center gap-1 mt-auto group-hover:gap-2 transition-all">Explore Train →</span>
        </a>

        <a href="/fuel" class="glass-card p-7 flex flex-col gap-4 group" data-reveal="fade" data-reveal-delay="200">
          <div class="w-11 h-11 rounded-xl bg-amber-accent/10 text-amber-accent flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-3 3-5 6-5 10a5 5 0 0010 0c0-4-2-7-5-10z" />
            </svg>
          </div>
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-accent block mb-2">Fuel</span>
            <h3 class="font-display font-bold text-xl text-slate-900 mb-2">Nutrition &amp; recipes</h3>
            <p class="text-sm text-slate-500 leading-relaxed">High-protein, fiber-forward recipes and the metabolic science behind why they work.</p>
          </div>
          <span class="text-sm font-semibold text-amber-accent flex items-center gap-1 mt-auto group-hover:gap-2 transition-all">Explore Fuel →</span>
        </a>

      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- ══════════════════════════════════════
       SIGNALS SHOWCASE — real posts
       ══════════════════════════════════════ -->
  <section class="py-20 md:py-28 bg-[#F0F4F1]/60 relative">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-end justify-between gap-6 flex-wrap mb-10" data-reveal="fade">
        <div>
          <h2 class="font-display font-bold text-2xl sm:text-3xl text-slate-900 tracking-tight mb-2">Start here: reading your own data</h2>
          <p class="text-sm text-slate-500 max-w-md">The pieces we point new readers to first, no wearable required to start.</p>
        </div>
        <a href="/signals" class="text-sm font-bold text-green-accent hover:text-green-accent-hover whitespace-nowrap">All Signals posts →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredPosts.map((post, i) => (
          <a
            href={`/signals/${post.frontmatter.slug}/`}
            class="glass-card overflow-hidden flex flex-col group"
            data-reveal="fade"
            data-reveal-delay={i * 100}
          >
            <div class="w-full h-36 overflow-hidden bg-slate-100">
              <img
                src={post.frontmatter.featured_image}
                alt={post.frontmatter.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-4 flex flex-col gap-1.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Signals</span>
              <h4 class="font-display font-bold text-sm text-slate-900 leading-snug group-hover:text-green-accent transition-colors">
                {post.frontmatter.title}
              </h4>
            </div>
          </a>
        ))}

        <!-- Coming-soon series card -->
        <a href="/signals" class="glass-card overflow-hidden flex flex-col group border-dashed" data-reveal="fade" data-reveal-delay={featuredPosts.length * 100}>
          <div class="w-full h-36 overflow-hidden bg-slate-100 relative">
            <img
              src="/images/uploads/ai-track-your-health-data.jpg"
              alt="Phone showing a health data app"
              class="w-full h-full object-cover opacity-80 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500"
            />
            <span class="absolute top-3 right-3 text-[9px] font-extrabold uppercase tracking-wider text-slate-500 bg-white/90 backdrop-blur border border-black/8 px-2 py-0.5 rounded-full">New series</span>
          </div>
          <div class="p-4 flex flex-col gap-1.5">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Signals · AI &amp; Health</span>
            <h4 class="font-display font-bold text-sm text-slate-400 leading-snug">
              AI &amp; Your Health: how it's already changing care, and how to use it yourself
            </h4>
          </div>
        </a>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- ══════════════════════════════════════
       MANIFESTO
       ══════════════════════════════════════ -->
  <section class="py-24 md:py-32 bg-[#0B0D0C] dark-block relative overflow-hidden">
    <div class="absolute top-1/3 left-1/4 w-[400px] h-[400px] bg-green-accent/8 rounded-full blur-[130px] pointer-events-none animate-pulse-glow"></div>
    <div class="max-w-3xl mx-auto px-6 relative z-10">
      <span class="text-[11px] font-bold uppercase tracking-wider text-green-accent block mb-6" data-reveal="fade">Why this site exists</span>
      <blockquote class="font-display font-semibold text-3xl sm:text-4xl text-white leading-tight tracking-tight mb-8" data-reveal="fade" data-reveal-delay="100">
        The health system is taxed. <em class="font-serif italic font-normal text-green-accent">It's on you</em> to make sure it's working for you.
      </blockquote>
      <p class="text-gray-400 text-base leading-relaxed mb-4" data-reveal="fade" data-reveal-delay="200">
        Appointments are shorter. Waitlists are longer. The data about your own body increasingly sits in an app on your phone before it ever reaches a doctor.
      </p>
      <p class="text-gray-400 text-base leading-relaxed" data-reveal="fade" data-reveal-delay="300">
        That's not a reason to panic. It's a reason to get literate. Self Health Living exists to make that data legible, one plain-English breakdown at a time, whether or not you ever open our app.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       APP CTA (secondary)
       ══════════════════════════════════════ -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <a href="/app" class="glass-card flex flex-col sm:flex-row items-center gap-6 p-7 sm:p-8" data-reveal="fade">
        <div class="w-16 h-16 rounded-2xl overflow-hidden shadow-sm flex-shrink-0 border border-black/8">
          <img src="/images/brand/app-icon.jpg" alt="SelfHealth app icon" class="w-full h-full object-cover" />
        </div>
        <div class="flex-grow text-center sm:text-left">
          <div class="text-[11px] font-bold uppercase tracking-wider text-cyan-accent mb-1.5">Prefer it automatic</div>
          <h3 class="font-display font-bold text-lg text-slate-900 mb-1.5">SelfHealth reads your data for you, daily</h3>
          <p class="text-sm text-slate-500">Same translation, running in the background, synced from Apple Health and your lab PDFs, no reading required.</p>
        </div>
        <span class="flex-shrink-0 px-6 py-3 border-2 border-slate-200 hover:border-cyan-accent hover:text-cyan-accent text-slate-700 text-sm font-bold rounded-full transition-all duration-300 whitespace-nowrap">
          Get the app →
        </span>
      </a>
    </div>
  </section>
</Layout>

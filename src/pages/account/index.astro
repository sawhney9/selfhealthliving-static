---
import Layout from '../../layouts/Layout.astro';
import { MARKERS } from '../../lib/markers.js';
import { GUIDANCE_PATHS } from '../../lib/guidance.js';
import { articleTitles } from '../../lib/articles.js';

const categories = [...new Set(MARKERS.map((m) => m.category))];
const titles = JSON.stringify(articleTitles(GUIDANCE_PATHS));
const input =
  'rounded-lg border border-black/10 px-3 py-2 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-green-accent/40';
const markerOptions = categories.map((c) => ({ c, markers: MARKERS.filter((m) => m.category === c) }));
---

<Layout
  title="My Health | Self Health Living"
  description="Your bloodwork and saved calculator readings, synced with the SelfHealth app."
  noindex
>
  <div id="account-root" data-titles={titles} class="py-14 px-6 md:px-12 max-w-5xl mx-auto w-full">
    <div id="account-loading" class="text-slate-400 text-sm py-24 text-center">Loading your health data…</div>

    <div id="account-body" class="hidden">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-green-accent mb-2">My Health</p>
          <h1 class="font-display font-black text-3xl sm:text-5xl text-slate-900 tracking-tight">
            Hi, <span id="account-name"></span>
          </h1>
          <p class="text-sm text-slate-500 mt-2">Synced with your SelfHealth app account.</p>
        </div>
        <button id="signout-btn" type="button" class="text-sm font-semibold text-slate-400 hover:text-red-500 transition-colors cursor-pointer">Sign out</button>
      </div>

      <!-- Bloodwork -->
      <section class="mb-14">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
          <h2 class="font-display font-bold text-2xl text-slate-900">Bloodwork</h2>
          <div class="flex flex-wrap gap-2">
            <label class="px-5 py-2.5 rounded-full text-sm font-bold text-white bg-green-accent hover:bg-green-accent-hover transition-all duration-300 cursor-pointer">
              Upload lab report (PDF)
              <input id="pdf-input" type="file" accept="application/pdf" class="sr-only" />
            </label>
            <button id="add-toggle" type="button" class="px-5 py-2.5 rounded-full text-sm font-bold text-green-accent border border-green-accent/30 hover:bg-green-accent/5 transition-all duration-300 cursor-pointer">
              + Enter by hand
            </button>
          </div>
        </div>

        <!-- PDF import: status, then a review list before anything is saved -->
        <div id="import-panel" class="hidden glass-card p-6 mb-6">
          <div id="import-status" class="text-sm text-slate-600" aria-live="polite"></div>
          <form id="import-form" class="hidden">
            <div class="flex flex-wrap items-end justify-between gap-4 mb-4">
              <div>
                <p class="font-display font-bold text-lg text-slate-900">Review what we found</p>
                <p class="text-sm text-slate-500">Uncheck anything that looks wrong, or fix a value before saving. Amber rows are worth a second look.</p>
              </div>
              <label class="block">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1.5">Test date</span>
                <input id="import-date" type="date" required class={input} />
              </label>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="text-left text-xs font-bold uppercase tracking-wider text-slate-400 border-b border-black/8">
                    <th class="py-2 pr-3 w-8"><input id="import-all" type="checkbox" checked class="w-4 h-4 accent-green-600" aria-label="Select all" /></th>
                    <th class="py-2 pr-3">Marker</th>
                    <th class="py-2 pr-3">Value</th>
                    <th class="py-2 pr-3">Unit</th>
                    <th class="py-2 pr-3">Lab range</th>
                    <th class="py-2"></th>
                  </tr>
                </thead>
                <tbody id="import-rows"></tbody>
              </table>
            </div>
            <div class="flex flex-wrap items-center gap-4 mt-5">
              <p class="text-xs text-slate-400 flex-1 min-w-[220px]">The report is read by the same AI service the SelfHealth app uses (Google Gemini). It isn't stored. Only the values you save are kept in your account.</p>
              <button type="button" id="import-cancel" class="text-sm text-slate-500 hover:text-slate-900 cursor-pointer">Cancel</button>
              <button type="submit" id="import-save" class="px-6 py-2.5 rounded-full text-sm font-bold text-white bg-green-accent hover:bg-green-accent-hover disabled:opacity-50 transition-all duration-300 cursor-pointer">Save results</button>
            </div>
          </form>
        </div>

        <!-- Manual entry -->
        <form id="add-form" class="hidden glass-card p-6 mb-6">
          <div class="flex flex-wrap items-end gap-5 mb-5">
            <label class="block">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1.5">Test date</span>
              <input id="add-date" type="date" required class={input} />
            </label>
            <label class="flex items-center gap-2 text-sm text-slate-600 pb-2">
              <input id="add-fasting" type="checkbox" class="w-4 h-4 accent-green-600" /> Fasting draw
            </label>
          </div>
          <div id="add-rows" class="flex flex-col gap-3 mb-4"></div>
          <template id="add-row-tpl">
            <div class="add-row flex flex-wrap items-center gap-3">
              <select class={`${input} flex-1 min-w-[220px]`} data-marker required>
                <option value="">Choose a marker…</option>
                {markerOptions.map(({ c, markers }) => (
                  <optgroup label={c}>
                    {markers.map((m) => (
                      <option value={m.name} data-unit={m.unit}>{m.fullName === m.name ? m.name : `${m.name} (${m.fullName})`}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
              <input type="number" step="any" required placeholder="Value" data-value class={`${input} w-32`} />
              <span data-unit class="text-sm text-slate-500 w-20"></span>
              <button type="button" data-remove class="text-xs font-semibold text-slate-400 hover:text-red-500 cursor-pointer">Remove</button>
            </div>
          </template>
          <div class="flex flex-wrap items-center gap-4">
            <button id="add-row-btn" type="button" class="text-sm font-semibold text-green-accent hover:underline cursor-pointer">+ Another marker</button>
            <span class="flex-1"></span>
            <button type="button" id="add-cancel" class="text-sm text-slate-500 hover:text-slate-900 cursor-pointer">Cancel</button>
            <button type="submit" class="px-6 py-2.5 rounded-full text-sm font-bold text-white bg-green-accent hover:bg-green-accent-hover disabled:opacity-50 transition-all duration-300 cursor-pointer">Save results</button>
          </div>
          <p id="add-status" class="text-sm text-slate-500 mt-3" aria-live="polite"></p>
          <p class="text-xs text-slate-400 mt-3">Values use the units shown, which match the SelfHealth app. Results you add here appear in the app's Bloodwork screen too.</p>
        </form>

        <div id="lab-summary" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4"></div>
        <p id="lab-hint" class="hidden text-sm text-slate-500 mb-6">Tap a marker to see its trend, set a goal, and get ideas for moving it.</p>
        <div id="lab-groups" class="flex flex-col gap-8"></div>
      </section>

      <!-- Calculator readings -->
      <section class="mb-14">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
          <h2 class="font-display font-bold text-2xl text-slate-900">Tracker readings</h2>
          <a href="/tools/" class="text-sm font-semibold text-green-accent hover:underline">All calculators →</a>
        </div>
        <div id="tool-cards" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
      </section>

      <!-- Account -->
      <section class="glass-card p-6 text-sm text-slate-600 leading-relaxed">
        <h2 class="font-display font-bold text-lg text-slate-900 mb-3">Account</h2>
        <p class="mb-2">Signed in as <span id="account-email" class="font-semibold text-slate-900"></span>.</p>
        <p class="mb-2"><a href="/account/reset/" class="font-semibold text-green-accent hover:underline">Change password</a></p>
        <p class="text-slate-500">To delete your account and all of its data, open the SelfHealth app and go to Settings → Delete Account.</p>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { watchSession, needsSecondFactor, loginUrl, signOut } from '../../lib/auth.js';
  import {
    fetchLabResults,
    addLabResults,
    deleteLabResult,
    fetchToolEntries,
    fetchGoals,
    extractLabsFromPdf,
    referenceRangeText,
  } from '../../lib/healthData.js';
  import { findMarker, markerStatus, barPosition, formatMarkerValue, STATUS, MARKERS } from '../../lib/markers.js';
  import { TOOLS } from '../../lib/tools.js';
  import { trendChart, trendSummary, meetsGoal } from '../../lib/trendChart.js';
  import { guidanceFor } from '../../lib/guidance.js';
  import { guidanceHtml } from '../../lib/guidanceView.js';
  import { mountGoalEditor } from '../../lib/goalEditor.js';

  type Lab = { id: string; test_name: string; value: number; unit: string; date: string; fasting: boolean | null; reference_range: string | null };
  type Goal = { target: number; direction: 'at_most' | 'at_least' };

  const MAX_PDF_BYTES = 10 * 1024 * 1024;

  const esc = (s: unknown) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  const dayKey = (iso: string) => {
    const d = new Date(iso);
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  };
  const today = () => dayKey(new Date().toISOString());
  const normUnit = (u: string) => String(u || '').toLowerCase().replace(/μ/g, 'µ').replace(/\s/g, '');
  // Decimal places the lab reported (at most 2), so HbA1c reads 5.7, not 5.70.
  const digitsFor = (values: number[]) =>
    Math.min(2, Math.max(0, ...values.map((v) => (String(Number(v)).split('.')[1] || '').length)));
  const TONE: Record<string, string> = {
    green: 'bg-green-accent/10 text-green-accent',
    amber: 'bg-amber-100 text-amber-700',
    red: 'bg-red-50 text-red-600',
  };

  function sparkline(values: number[], color = '#00A36C') {
    if (values.length < 2) return '';
    const w = 120, h = 32, pad = 3;
    const min = Math.min(...values);
    const range = Math.max(...values) - min || 1;
    const pts = values
      .map((v, i) => `${(pad + (i / (values.length - 1)) * (w - pad * 2)).toFixed(1)},${(h - pad - ((v - min) / range) * (h - pad * 2)).toFixed(1)}`)
      .join(' ');
    return `<svg viewBox="0 0 ${w} ${h}" class="w-28 h-8" preserveAspectRatio="none" aria-hidden="true"><polyline points="${pts}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg>`;
  }

  function rangeBar(marker: any, value: number) {
    const p = barPosition(marker, value);
    return `<div class="relative h-2 rounded-full bg-slate-200 w-full max-w-[220px]" aria-hidden="true">
      <div class="absolute inset-y-0 rounded-full bg-green-accent/40" style="left:${p.optimalLow * 100}%;width:${Math.max(2, (p.optimalHigh - p.optimalLow) * 100)}%"></div>
      <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-slate-900 border-2 border-white shadow" style="left:${p.value * 100}%"></div>
    </div>`;
  }

  /** The optimal zone as a chart band; a zero floor isn't drawn as a lower edge. */
  function markerBand(marker: any) {
    const r = marker?.range;
    if (!r) return null;
    return { low: r.optimalLow > 0 ? r.optimalLow : null, high: r.optimalHigh };
  }

  function goalSuggestion(name: string, marker: any, status: string | null): Goal | undefined {
    const r = marker?.range;
    if (!r) return undefined;
    const atMost: Goal = { target: r.optimalHigh, direction: 'at_most' };
    const atLeast: Goal = { target: r.optimalLow, direction: 'at_least' };
    if (status === 'high' || status === 'criticalHigh') return atMost;
    if (status === 'low' || status === 'criticalLow') return atLeast;
    // In range: guard the side that matters for this marker.
    return guidanceFor(name, null)?.direction === 'raise' && r.optimalLow > 0 ? atLeast : atMost;
  }

  function init() {
    const root = document.getElementById('account-root');
    if (!root) return;
    const titles = JSON.parse(root.dataset.titles || '{}');

    let labs: Lab[] = [];
    let goals: Record<string, Goal> = {};
    let toolRows: any[] = [];
    let loadedFor: string | null = null;

    async function loadAll() {
      [labs, toolRows, goals] = (await Promise.all([fetchLabResults(), fetchToolEntries(), fetchGoals()])) as any;
      renderLabs();
      renderTools();
    }

    function grouped() {
      const byName = new Map<string, Lab[]>();
      for (const r of labs) {
        const key = findMarker(r.test_name)?.name || r.test_name;
        if (!byName.has(key)) byName.set(key, []);
        byName.get(key)!.push(r);
      }
      return byName;
    }

    // ---------- Bloodwork list ----------
    function renderLabs() {
      const byName = grouped();
      const summary = document.getElementById('lab-summary')!;
      const groupsEl = document.getElementById('lab-groups')!;
      document.getElementById('lab-hint')!.classList.toggle('hidden', !byName.size);
      if (!byName.size) {
        summary.innerHTML = '';
        groupsEl.innerHTML = `<div class="glass-card p-8 text-center text-slate-500">
          <p class="mb-2 font-semibold text-slate-700">No lab results yet.</p>
          <p class="text-sm">Upload a lab report PDF above, type results in by hand, or import them in the SelfHealth app. They'll show up here.</p>
        </div>`;
        return;
      }

      // Remember which markers are open so a re-render doesn't collapse them.
      const open = new Set([...groupsEl.querySelectorAll<HTMLDetailsElement>('details[open]')].map((d) => d.dataset.name));

      let optimal = 0, flagged = 0, onGoal = 0, withGoal = 0;
      const rows: Record<string, string[]> = {};
      const names: string[] = [];
      for (const [name, results] of byName) {
        const marker = findMarker(name);
        const latest = results[results.length - 1];
        const sameUnit = Boolean(marker) && normUnit(latest.unit) === normUnit(marker!.unit);
        const status = sameUnit ? markerStatus(marker, Number(latest.value)) : null;
        if (status === 'optimal') optimal++;
        else if (status) flagged++;
        const goal = goals[name];
        if (goal) {
          withGoal++;
          if (meetsGoal(goal, Number(latest.value))) onGoal++;
        }
        const group = marker?.category || 'Other';
        const pill = status ? `<span class="text-xs font-bold px-2 py-0.5 rounded-full ${TONE[STATUS[status].tone]}">${STATUS[status].label}</span>` : '';
        const goalChip = goal
          ? `<span class="text-xs font-semibold ${meetsGoal(goal, Number(latest.value)) ? 'text-green-accent' : 'text-indigo-600'}">Goal ${goal.direction === 'at_most' ? '≤' : '≥'} ${esc(formatMarkerValue(goal.target))}${meetsGoal(goal, Number(latest.value)) ? ' ✓' : ''}</span>`
          : '';
        const idx = names.push(name) - 1;
        (rows[group] ||= []).push(`<details data-name="${esc(name)}" data-idx="${idx}" class="glass-card p-0 overflow-hidden"${open.has(name) ? ' open' : ''}>
          <summary class="list-none cursor-pointer p-4 md:p-5 flex flex-wrap items-center gap-x-6 gap-y-3">
            <div class="min-w-[160px] flex-1">
              <p class="font-semibold text-slate-900">${esc(name)}</p>
              <p class="text-xs text-slate-400">${esc(marker?.fullName && marker.fullName !== name ? marker.fullName : fmtDate(latest.date))}</p>
            </div>
            <div class="w-36">
              <p class="font-display font-bold text-xl text-slate-900">${esc(formatMarkerValue(latest.value))} <span class="text-xs font-semibold text-slate-400">${esc(latest.unit)}</span></p>
              <div class="flex flex-wrap items-center gap-2">${pill}${goalChip}</div>
            </div>
            <div class="hidden sm:block flex-1 min-w-[160px]">${sameUnit && marker!.range ? rangeBar(marker, Number(latest.value)) : ''}</div>
            <div class="hidden md:block">${sparkline(results.map((r) => Number(r.value)), !status || status === 'optimal' ? '#00A36C' : '#D97706')}</div>
            <span class="text-slate-400 text-sm" aria-hidden="true">▾</span>
          </summary>
          <div data-body class="px-4 md:px-5 pb-5 border-t border-black/6 pt-4"></div>
        </details>`);
      }

      const last = labs.reduce((a, b) => (new Date(a.date) > new Date(b.date) ? a : b));
      const stat = (label: string, value: string | number, tone = 'text-slate-900') =>
        `<div class="glass-card p-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">${label}</p><p class="font-display font-black text-2xl ${tone}">${value}</p></div>`;
      summary.innerHTML =
        stat('Markers', byName.size) +
        stat('Optimal', optimal, 'text-green-accent') +
        (withGoal ? stat('Goals met', `${onGoal}/${withGoal}`, 'text-indigo-600') : stat('Outside optimal', flagged, flagged ? 'text-amber-600' : 'text-slate-900')) +
        stat('Last test', fmtDate(last.date));

      const order = [...new Set(MARKERS.map((m) => m.category)), 'Other'];
      groupsEl.innerHTML = order
        .filter((g) => rows[g])
        .map((g) => `<div><h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">${esc(g)}</h3><div class="flex flex-col gap-3">${rows[g].join('')}</div></div>`)
        .join('');

      groupsEl.querySelectorAll<HTMLDetailsElement>('details').forEach((d) => {
        const name = names[Number(d.dataset.idx)];
        const fill = () => renderMarkerBody(d, name, byName.get(name)!);
        if (d.open) fill();
        d.addEventListener('toggle', () => d.open && !d.dataset.filled && fill());
      });
    }

    // Detail view for one marker: chart, goal, tips, history.
    function renderMarkerBody(d: HTMLDetailsElement, name: string, results: Lab[]) {
      d.dataset.filled = '1';
      const body = d.querySelector<HTMLElement>('[data-body]')!;
      const marker = findMarker(name);
      const latest = results[results.length - 1];
      const sameUnit = Boolean(marker) && normUnit(latest.unit) === normUnit(marker!.unit);
      const status = sameUnit ? markerStatus(marker, Number(latest.value)) : null;
      const values = results.map((r) => Number(r.value));
      const unit = latest.unit;
      const digits = digitsFor(values);
      const band = sameUnit ? markerBand(marker) : null;
      const goal = goals[name] || null;
      const points = results.map((r) => ({ date: r.date, value: Number(r.value) }));
      const position = status === 'high' || status === 'criticalHigh' ? 'high' : status === 'low' || status === 'criticalLow' ? 'low' : null;
      const g = guidanceFor(name, position);

      const history = results
        .slice()
        .reverse()
        .map(
          (r) => `<tr class="border-b border-black/6 last:border-0">
            <td class="py-1.5 pr-4 text-slate-500 whitespace-nowrap">${fmtDate(r.date)}${r.fasting ? ' · fasting' : ''}</td>
            <td class="py-1.5 pr-4 font-semibold text-slate-900 whitespace-nowrap">${esc(formatMarkerValue(r.value))} ${esc(r.unit)}</td>
            <td class="py-1.5 pr-4 text-slate-400 w-full">${r.reference_range ? `Lab range ${esc(r.reference_range)}` : ''}</td>
            <td class="py-1.5 text-right"><button type="button" data-del="${esc(r.id)}" class="text-xs font-semibold text-slate-400 hover:text-red-500 cursor-pointer whitespace-nowrap">Delete</button></td>
          </tr>`
        )
        .join('');

      const pill = status ? `<span class="text-xs font-bold px-2 py-0.5 rounded-full ${TONE[STATUS[status].tone]}">${STATUS[status].label}</span>` : '';
      const optimalText = band
        ? `${band.low != null ? `${formatMarkerValue(band.low)}–${formatMarkerValue(band.high)}` : `≤ ${formatMarkerValue(band.high)}`} ${esc(unit)}`
        : '';
      body.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-5 gap-5 items-start mb-4">
          <div class="md:col-span-3 rounded-xl border border-black/6 bg-white p-3">${trendChart({ points, band, goal, unit, digits })}</div>
          <div class="md:col-span-2 flex flex-col gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Latest · ${fmtDate(latest.date)}</p>
              <p class="font-display font-black text-3xl text-slate-900">${esc(formatMarkerValue(latest.value))} <span class="text-sm font-semibold text-slate-400">${esc(unit)}</span></p>
              <div class="mt-1">${pill}</div>
            </div>
            ${optimalText ? `<p class="text-sm text-slate-600"><span class="text-slate-400">Optimal range</span><br /><span class="font-semibold text-slate-900">${optimalText}</span></p>` : ''}
            <p class="text-sm text-slate-600">${esc(trendSummary({ points, band, goal, unit, digits }))}</p>
            <div data-goal></div>
          </div>
        </div>
        ${marker?.about ? `<p class="text-sm text-slate-500 leading-relaxed mb-4">${esc(marker.about)}</p>` : ''}
        ${g ? `<details class="group/tips mb-3"><summary class="list-none cursor-pointer inline-flex items-center gap-1.5 text-sm font-semibold text-green-accent hover:underline">${g.direction === 'lower' ? 'How to bring it down' : 'How to bring it up'} <span class="transition-transform group-open/tips:rotate-180">▾</span></summary><div class="mt-3">${guidanceHtml(g, titles)}</div></details>` : ''}
        <details class="group/hist"><summary class="list-none cursor-pointer inline-flex items-center gap-1.5 text-sm font-semibold text-slate-500 hover:text-slate-900">All results (${results.length}) <span class="transition-transform group-open/hist:rotate-180">▾</span></summary>
          <table class="w-full text-sm mt-2"><tbody>${history}</tbody></table>
        </details>`;

      mountGoalEditor(body.querySelector('[data-goal]')!, {
        metric: name,
        goal,
        suggestion: goalSuggestion(name, marker, status),
        unit,
        digits,
        onChange: (next) => {
          if (next) goals[name] = next as Goal;
          else delete goals[name];
          renderLabs();
        },
      });

      body.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          if (!btn.dataset.armed) {
            btn.dataset.armed = '1';
            btn.textContent = 'Confirm delete';
            btn.classList.add('text-red-500');
            return;
          }
          btn.disabled = true;
          try {
            await deleteLabResult(btn.dataset.del!);
            labs = labs.filter((l) => l.id !== btn.dataset.del);
            renderLabs();
          } catch {
            btn.textContent = 'Couldn’t delete';
          }
        })
      );
    }

    // ---------- Tracker readings ----------
    function renderTools() {
      const el = document.getElementById('tool-cards')!;
      const cards = TOOLS.map((tool) => {
        const entries = toolRows.filter((r) => r.tool === tool.slug);
        if (!entries.length) return '';
        const points = entries.map((e) => ({ date: e.recorded_at, value: Number(e.value) }));
        const goal = goals[`tool:${tool.slug}`] || null;
        const opts = { points, band: tool.band || null, goal, unit: tool.unit, digits: tool.digits };
        return `<a href="/tools/${tool.slug}/" class="glass-card p-5 flex flex-col gap-2 hover:-translate-y-0.5 transition-all duration-300">
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-semibold text-slate-900">${esc(tool.title)}</p>
            <p class="text-xs text-slate-400">${entries.length} reading${entries.length === 1 ? '' : 's'}</p>
          </div>
          <div class="rounded-lg bg-white border border-black/6 p-2">${trendChart(opts)}</div>
          <p class="text-xs text-slate-500">${esc(trendSummary(opts))}</p>
        </a>`;
      }).join('');
      el.innerHTML =
        cards ||
        `<div class="glass-card p-8 text-center text-slate-500 md:col-span-2">
          <p class="mb-2 font-semibold text-slate-700">No tracker readings yet.</p>
          <p class="text-sm">Use any <a href="/tools/" class="text-green-accent font-semibold hover:underline">calculator</a> and save the result to start a trend.</p>
        </div>`;
    }

    // ---------- PDF import ----------
    const pdfInput = document.getElementById('pdf-input') as HTMLInputElement;
    const importPanel = document.getElementById('import-panel')!;
    const importStatus = document.getElementById('import-status')!;
    const importForm = document.getElementById('import-form') as HTMLFormElement;
    const importRows = document.getElementById('import-rows')!;
    const importDate = document.getElementById('import-date') as HTMLInputElement;
    let found: any[] = [];

    function closeImport() {
      importPanel.classList.add('hidden');
      importForm.classList.add('hidden');
      importRows.innerHTML = '';
      found = [];
      pdfInput.value = '';
    }

    pdfInput.addEventListener('change', async () => {
      const file = pdfInput.files?.[0];
      if (!file) return;
      document.getElementById('add-form')!.classList.add('hidden');
      importPanel.classList.remove('hidden');
      importForm.classList.add('hidden');
      if (file.type !== 'application/pdf' && !/\.pdf$/i.test(file.name)) {
        importStatus.textContent = 'That file isn’t a PDF. Choose the PDF your lab or patient portal gave you.';
        return;
      }
      if (file.size > MAX_PDF_BYTES) {
        importStatus.textContent = 'That PDF is over 10 MB. Try downloading a smaller version from your patient portal.';
        return;
      }
      importStatus.innerHTML = `<span class="inline-flex items-center gap-2"><span class="w-4 h-4 rounded-full border-2 border-green-accent border-t-transparent animate-spin"></span>Reading ${esc(file.name)}… this usually takes 20–60 seconds.</span>`;
      try {
        found = (await extractLabsFromPdf(file)).filter((m: any) => m && m.marker && Number.isFinite(Number(m.value)));
      } catch (err: any) {
        importStatus.textContent = err.message;
        pdfInput.value = '';
        return;
      }
      if (!found.length) {
        importStatus.textContent = 'We couldn’t find any lab values in that PDF. If it’s a scan or photo, try the SelfHealth app’s camera import, or enter the values by hand.';
        pdfInput.value = '';
        return;
      }

      // Default the test date to the date most results were collected.
      const dates = found.map((m) => m.collectionDate).filter(Boolean);
      const common = dates.sort((a, b) => dates.filter((x) => x === b).length - dates.filter((x) => x === a).length)[0];
      importDate.value = common && /^\d{4}-\d{2}-\d{2}$/.test(common) ? common : today();
      importDate.max = today();

      importRows.innerHTML = found
        .map((m, i) => {
          const known = findMarker(m.marker);
          const name = known?.name || m.marker;
          const dup = labs.some((l) => (findMarker(l.test_name)?.name || l.test_name) === name && dayKey(l.date) === importDate.value && Number(l.value) === Number(m.value));
          const shaky = m.confidence !== 'high' || m.reviewSuggested;
          const checked = !dup && m.confidence !== 'low';
          const note = dup
            ? '<span class="text-xs text-slate-400">Already saved</span>'
            : m.confidence === 'low'
              ? '<span class="text-xs font-semibold text-red-600">Low confidence</span>'
              : shaky
                ? '<span class="text-xs font-semibold text-amber-700">Check this</span>'
                : '';
          return `<tr class="border-b border-black/6 last:border-0 ${shaky && !dup ? 'bg-amber-50/60' : ''}" data-i="${i}">
            <td class="py-2 pr-3"><input type="checkbox" data-pick class="w-4 h-4 accent-green-600"${checked ? ' checked' : ''} aria-label="Save ${esc(name)}" /></td>
            <td class="py-2 pr-3 font-semibold text-slate-900">${esc(name)}${known ? '' : ' <span class="text-xs font-normal text-slate-400">(custom)</span>'}</td>
            <td class="py-2 pr-3"><input type="number" step="any" data-val value="${esc(m.value)}" class="w-24 rounded-md border border-black/10 px-2 py-1 text-sm" /></td>
            <td class="py-2 pr-3 text-slate-500">${esc(m.unit)}</td>
            <td class="py-2 pr-3 text-slate-400">${esc(referenceRangeText(m.refLow, m.refHigh) || '')}</td>
            <td class="py-2">${note}</td>
          </tr>`;
        })
        .join('');
      const n = found.length;
      importStatus.textContent = `Found ${n} result${n === 1 ? '' : 's'}.`;
      importForm.classList.remove('hidden');
    });

    document.getElementById('import-all')!.addEventListener('change', (e) => {
      const on = (e.target as HTMLInputElement).checked;
      importRows.querySelectorAll<HTMLInputElement>('[data-pick]').forEach((c) => (c.checked = on));
    });
    document.getElementById('import-cancel')!.addEventListener('click', closeImport);

    importForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const entries = [...importRows.querySelectorAll<HTMLTableRowElement>('tr')]
        .filter((tr) => tr.querySelector<HTMLInputElement>('[data-pick]')!.checked)
        .map((tr) => {
          const m = found[Number(tr.dataset.i)];
          return {
            test_name: findMarker(m.marker)?.name || m.marker,
            value: parseFloat(tr.querySelector<HTMLInputElement>('[data-val]')!.value),
            unit: m.unit,
            reference_range: referenceRangeText(m.refLow, m.refHigh),
          };
        })
        .filter((x) => Number.isFinite(x.value));
      if (!entries.length) return;
      const save = document.getElementById('import-save') as HTMLButtonElement;
      save.disabled = true;
      try {
        await addLabResults(entries, { day: importDate.value });
        closeImport();
        labs = (await fetchLabResults()) as Lab[];
        renderLabs();
        importPanel.classList.remove('hidden');
        importStatus.textContent = `Saved ${entries.length} result${entries.length === 1 ? '' : 's'}. They're in the SelfHealth app too.`;
      } catch {
        importStatus.textContent = 'Couldn’t save. Check your connection and try again.';
      } finally {
        save.disabled = false;
      }
    });

    // ---------- Manual entry ----------
    const form = document.getElementById('add-form') as HTMLFormElement;
    const rowsEl = document.getElementById('add-rows')!;
    const tpl = document.getElementById('add-row-tpl') as HTMLTemplateElement;
    const statusEl = document.getElementById('add-status')!;

    function addRow() {
      const row = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const select = row.querySelector('select')!;
      select.addEventListener('change', () => {
        row.querySelector('[data-unit]')!.textContent = select.selectedOptions[0]?.dataset.unit || '';
      });
      row.querySelector('[data-remove]')!.addEventListener('click', () => {
        if (rowsEl.children.length > 1) row.remove();
      });
      rowsEl.appendChild(row);
    }

    function openForm(isOpen: boolean) {
      form.classList.toggle('hidden', !isOpen);
      if (isOpen) {
        closeImport();
        if (!rowsEl.children.length) addRow();
        const date = document.getElementById('add-date') as HTMLInputElement;
        date.value ||= today();
        date.max = today();
      }
    }

    document.getElementById('add-toggle')!.addEventListener('click', () => openForm(form.classList.contains('hidden')));
    document.getElementById('add-cancel')!.addEventListener('click', () => openForm(false));
    document.getElementById('add-row-btn')!.addEventListener('click', addRow);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const entries = [...rowsEl.querySelectorAll('.add-row')].map((row) => {
        const select = row.querySelector('select')!;
        return {
          test_name: select.value,
          value: parseFloat((row.querySelector('[data-value]') as HTMLInputElement).value),
          unit: select.selectedOptions[0]?.dataset.unit || '',
        };
      });
      if (entries.some((x) => !x.test_name || !Number.isFinite(x.value))) return;
      const submit = form.querySelector('button[type=submit]') as HTMLButtonElement;
      submit.disabled = true;
      statusEl.textContent = 'Saving…';
      try {
        await addLabResults(entries, {
          day: (document.getElementById('add-date') as HTMLInputElement).value,
          fasting: (document.getElementById('add-fasting') as HTMLInputElement).checked || null,
        });
        rowsEl.innerHTML = '';
        statusEl.textContent = '';
        openForm(false);
        labs = (await fetchLabResults()) as Lab[];
        renderLabs();
      } catch {
        statusEl.textContent = 'Couldn’t save. Check your connection and try again.';
      } finally {
        submit.disabled = false;
      }
    });

    document.getElementById('signout-btn')!.addEventListener('click', async () => {
      await signOut();
      location.replace('/');
    });

    const stop = watchSession(async (session) => {
      if (!session) return location.replace(loginUrl('/account/'));
      if (await needsSecondFactor()) return location.replace(loginUrl('/account/'));
      if (loadedFor === session.user.id) return;
      loadedFor = session.user.id;
      const meta = session.user.user_metadata || {};
      document.getElementById('account-name')!.textContent = (meta.full_name || meta.name || '').split(' ')[0] || 'there';
      document.getElementById('account-email')!.textContent = session.user.email || '';
      try {
        await loadAll();
      } catch {
        document.getElementById('lab-groups')!.innerHTML = '<p class="text-sm text-red-500">Couldn’t load your data. Refresh to try again.</p>';
      }
      document.getElementById('account-loading')!.classList.add('hidden');
      document.getElementById('account-body')!.classList.remove('hidden');
    });
    document.addEventListener('astro:before-swap', stop, { once: true });
  }

  document.addEventListener('astro:page-load', init);
</script>
